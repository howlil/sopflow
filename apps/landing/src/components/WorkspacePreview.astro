---
/** Use the real, same-origin React playground rather than a second diagram implementation. */
---
<section id="preview" class="preview-section wrap" aria-labelledby="preview-title">
  <div class="preview-intro">
    <div>
      <h2 id="preview-title">Explore the SOP workspace.</h2>
      <p>Review the same procedure as a flowchart, BPMN, or editable steps.</p>
    </div>
    <a class="preview-open" href="/playground/">
      Open full workspace <svg class="icon" aria-hidden="true"><use href="#ic-arrow"></use></svg>
    </a>
  </div>

  <div class="preview-window-scene">
    <div class="product-window">
      <iframe
        class="playground-frame"
        src="/playground/"
        title="SOPFlow interactive playground"
        loading="lazy"
        referrerpolicy="same-origin"
      ></iframe>
    </div>
  </div>
  <p class="preview-caption">
    Changes are not saved after you leave or refresh.
    <a href="/playground/">Open playground in a full window</a>
  </p>
</section>
