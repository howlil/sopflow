{
  "name": "sopflow-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Sopflow monorepo",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howlil/sopflow.git"
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "pack:core": "pnpm --filter @sopflow/core pack",
    "pack:diagram": "pnpm --filter @sopflow/diagram pack",
    "pack:react": "pnpm --filter @sopflow/react pack",
    "pack:sop-ap": "pnpm --filter @sopflow/sop-ap pack",
    "pack:adapter-sop-ta": "pnpm --filter @sopflow/adapter-sop-ta pack"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13"
  },
  "license": "MIT"
}
