{
  "name": "sopflow-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Sopflow monorepo",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howlil/sopflow.git"
  },
  "scripts": {
    "lint": "biome check .",
    "check:arch": "node scripts/check-boundaries.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "check": "pnpm check:package-names && pnpm lint && pnpm check:arch && pnpm typecheck && pnpm test && pnpm build",
    "pack:core": "pnpm --filter @sopflow/core pack",
    "pack:diagram": "pnpm --filter @sopflow/diagram pack",
    "pack:react": "pnpm --filter @sopflow/react pack",
    "changeset": "npm exec --yes --package=@changesets/cli@3.0.3 -- changeset",
    "release:version": "pnpm changeset version && pnpm install --lockfile-only --ignore-scripts",
    "test:release": "node --test scripts/npm-release.test.mjs",
    "release:bootstrap": "node scripts/npm-bootstrap.mjs",
    "release:trust": "node scripts/npm-trust.mjs",
    "fix:package-names": "node scripts/repair-workspace-names.mjs",
    "check:package-names": "node scripts/repair-workspace-names.mjs --check",
    "test:package-names": "node --test scripts/repair-workspace-names.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13"
  },
  "license": "MIT"
}
