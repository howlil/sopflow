{
  "files": {
    "includes": [
      "packages/core/src/**/*.ts",
      "packages/core/tests/**/*.ts",
      "packages/diagram/src/**/*.ts",
      "packages/diagram/tests/**/*.ts",
      "packages/react/src/**/*.ts",
      "packages/react/src/**/*.tsx",
      "apps/**/*.ts",
      "apps/**/*.tsx"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineEnding": "lf"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
