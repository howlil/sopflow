{
  "name": "@sopflow/integration-sop-ta",
  "version": "0.0.0",
  "description": "Private SOP-TA compatibility integration and lossless legacy conversion",
  "type": "module",
  "sideEffects": false,
  "author": {
    "name": "howlil",
    "email": "mhdulilabshar27@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howlil/sopflow.git",
    "directory": "integrations/sop-ta"
  },
  "homepage": "https://github.com/howlil/sopflow#readme",
  "bugs": {
    "url": "https://github.com/howlil/sopflow/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.mjs",
