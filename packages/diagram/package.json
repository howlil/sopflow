{
  "name": "@sopflow/diagram",
  "version": "0.1.0",
  "description": "Deterministic layout engine for Sopflow workflow diagrams",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@sopflow/core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["sop", "workflow", "diagram", "layout"],
  "license": "MIT"
}
