{
  "name": "@sopflow/diagram",
  "version": "0.2.2",
  "description": "Deterministic layout engine for Sopflow workflow diagrams",
  "type": "module",
  "sideEffects": false,
  "author": {
    "name": "howlil",
    "email": "mhdulilabshar27@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howlil/sopflow.git",
    "directory": "packages/diagram"
  },
  "homepage": "https://github.com/howlil/sopflow#readme",
  "bugs": {
    "url": "https://github.com/howlil/sopflow/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "bench:routes": "pnpm build && node ../../scripts/bench-routing.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@sopflow/core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "sop",
    "workflow",
    "diagram",
    "layout"
  ],
  "license": "MIT"
}
