{
  "name": "@sopflow/react",
  "version": "0.3.4",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@sopflow/core": "workspace:*",
    "@sopflow/diagram": "workspace:*",
    "motion": "^12.23.24",
    "lucide-react": "^0.468.0",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-accordion": "^1.2.12"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tsdown/css": "^0.23.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "description": "React SOP editor, diagram and workflow UI for SOPFlow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/howlil/sopflow.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/howlil/sopflow#readme",
  "bugs": {
    "url": "https://github.com/howlil/sopflow/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "sop",
    "workflow",
    "diagram",
    "editor",
    "react",
    "typescript"
  ]
}
